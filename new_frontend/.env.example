# ==============================================================================
# PRAMAAN Legal Metrology Frontend — Environment Variables
# ==============================================================================

# Production Backend API URL (e.g. Render Web Service URL + /api)
# Example: VITE_API_BASE_URL=https://pramaan-backend.onrender.com/api
# Leave blank for local development to use Vite's dev proxy (/api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=

# CAPTCHA-as-a-Service Configuration
VITE_CAPTCHA_API_URL=http://localhost:4000
VITE_CAPTCHA_SITE_KEY=pramaan_inspector_site_key
