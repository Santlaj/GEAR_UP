# ==============================================================================
# Legal Metrology Compliance Scanning Platform (LMCS)
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   copy .env.example .env

# ── Security & Authentication ──────────────────────────────────────────────────
# 32+ byte secret key for signing inspector & admin JWT tokens
JWT_SECRET=dev-only-change-me-to-a-32-byte-secure-secret-key-12345
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=28800

# ── Database Connection (PostgreSQL 16 with Row Level Security) ────────────────
# Standard application connection (subject to RLS enforcement)
DATABASE_URL=postgresql+asyncpg://lmcs_app:lmcs_app@localhost:5432/lmcs

# Superuser / migration / seed connection (bypasses RLS for schema and seed setup)
DATABASE_ADMIN_URL=postgresql+asyncpg://lmcs:lmcs@localhost:5432/lmcs

# ── Groq Vision-Language Model (VLM) Extraction ────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
EXTRACTION_CONFIDENCE_THRESHOLD=0.55

# ── Public URLs & Host Whitelisting ───────────────────────────────────────────
VERIFY_BASE_URL=https://verify.lmcs.example.gov.in/r
INSPECTOR_PORTAL_HOSTS=inspector.localhost,localhost:5173
ADMIN_PORTAL_HOSTS=admin.localhost,localhost:5174
REPORT_STORAGE_DIR=storage/reports

# ── Initial Seed Credentials (Used by: python -m app.seed) ─────────────────────
INITIAL_PASSWORD_AYENISHA=DevPassword@123
INITIAL_PASSWORD_SANTLAJ=DevPassword@123
INITIAL_PASSWORD_VAISHNAVI=DevPassword@123
INITIAL_PASSWORD_VEDANT=DevPassword@123
INITIAL_PASSWORD_ADARSH=DevPassword@123
INITIAL_PASSWORD_INSPECTOR3=DevPassword@123
INITIAL_PASSWORD_INSPECTOR4=DevPassword@123
